# Copier ce fichier en .env puis adapter.

# Adresse publique de l'application (utilisée dans les liens envoyés par e-mail)
APP_URL=http://localhost:5173
PORT=3001

# Base SQLite (fichier créé automatiquement)
DB_PATH=./data/app.db

# Mot de passe de l'espace « Équipe programme » (/admin).
# En mode démo, s'il est vide, le mot de passe est « demo ».
ADMIN_PASSWORD=

# Durée de validité des liens personnels (jours)
TOKEN_TTL_DAYS=30

# Cookies en HTTPS uniquement (à mettre à true en production derrière HTTPS)
COOKIE_SECURE=false

# SMTP : laisser SMTP_HOST vide = MODE DÉMO. Aucun e-mail réel n'est envoyé :
# ils apparaissent dans la boîte de démo (/demo/boite) et dans la console,
# et la base est remplie automatiquement avec des données fictives.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Équipe programme <noreply@univ.fr>"
